{
	"name": "lab123/aws-sns",
	"description": "Amazon SNS notification channels (SMS and topics) for Laravel",
	"keywords": [
		"laravel",
		"notification",
		"aws",
		"sns",
		"sms"
	],
	"homepage": "https://github.com/lab123it/aws-sns",
	"license": "MIT",
	"authors": [
		{
			"name": "Jean Pierre",
			"email": "jean.pierre@lab123.com.br",
			"homepage": "https://lab123.com.br",
			"role": "Developer"
		}
	],
	"require": {
		"php": "^8.2",
		"aws/aws-sdk-php": "^3.300",
		"illuminate/notifications": "^12.60|^13.10",
		"illuminate/support": "^12.60|^13.10"
	},
	"require-dev": {
		"orchestra/testbench": "^10.0|^11.0",
		"phpunit/phpunit": "^11.5|^12.0"
	},
	"autoload": {
		"psr-4": {
			"Lab123\\AwsSns\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Lab123\\AwsSns\\Test\\": "tests"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Lab123\\AwsSns\\AwsSnsServiceProvider"
			]
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
